# ==========================================
# AUREUS AI TRADING SYSTEM - ENVIRONMENT TEMPLATE
# (Copy this to .env.local and fill in your actual credentials)
# ==========================================

# Google Gemini API Keys (Dual-Key High Availability)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_SECONDARY=your_secondary_gemini_key_here

# Windows VPS Connection & Bridge
VPS_HOST=your_vps_ip_here
VPS_PORT=8000
VPS_WINRM_USER=Administrator
VPS_WINRM_PASSWORD=your_vps_password_here
VPS_BRIDGE_URL=http://your_vps_ip_here:8000

# Target MT5 Account Login (USD)
MT5_ACCOUNT_TARGET=your_mt5_account_number

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Trading Execution Parameters
TRADING_SYMBOL=BTCUSDm
TRADING_MAGIC_NUMBER=778898
TRADING_FIXED_LOT=0.01
TRADING_SL_POINTS=70.0
TRADING_TP1_POINTS=140.0
TRADING_TP2_POINTS=200.0
TRADING_MAX_DAILY_LOSS=1.80
TRADING_CONFIDENCE_THRESHOLD=65
TRADING_MIN_ROOM_TO_RUN=80.0
TRADING_WIN_COOLDOWN=300
TRADING_LOSS_COOLDOWN=900

# Neon Serverless PostgreSQL Database URL
DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require

NEXT_PUBLIC_APP_NAME="Aureus AI - BTC Scalping Radar"
